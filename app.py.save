from flask import Flask, render_template, request, redirect, url_for

from config import Config
from dotenv import load_dotenv
from models import db, User, Event, Registration
from utils.auth_helpers import token_required

load_dotenv()


def create_app():
    app = Flask(__name__)
    app.config.from_object(Config)

    db.init_app(app)

    from routes.auth import auth_bp
    from routes.events import events_bp
    from routes.registrations import reg_bp

    app.register_blueprint(auth_bp, url_prefix='/api')
    app.register_blueprint(events_bp, url_prefix='/api')
    app.register_blueprint(reg_bp, url_prefix='/api')

    # ===== Страницы (frontend) =====

    @app.route('/')
    def index_page():
        return render_template('index.html')

    @app.route('/events')
    def events_page():
        inclusive_only = request.args.get('inclusive') in ('1', 'true')
        query = Event.query.order_by(Event.event_date)
        if inclusive_only:
            query = query.filter_by(is_inclusive=True)
        events = query.all()
        return render_template('events.html', events=events)

    @app.route('/login', methods=['GET', 'POST'])
    def login_page():
        if request.method == 'POST':
            email = (request.form.get('email') or '').strip().lower()
            password = request.form.get('password') or ''
            user = User.query.filter_by(email=email).first()
            if user and user.check_password(password):
                return redirect(url_for('profile_page', user_id=user.id))
            return render_template(
                'login.html',
                error='Неверный email или пароль'
            ), 401
        return render_template('login.html')

    @app.route('/register', methods=['GET', 'POST'])
    def register_page():
        if request.method == 'POST':
            username = (request.form.get('username') or '').strip()
            email = (request.form.get('email') or '').strip().lower()
            password = request.form.get('password') or ''
            role = request.form.get('role', 'participant')
            is_deaf = request.form.get('is_deaf') == 'true'
            needs = request.form.get('accessibility_needs') or ''

            if not username or len(password) < 8 or '@' not in email:
                return render_template(
                    'register.html',
                    error='Проверьте поля: имя, email, пароль минимум 8 символов'
                ), 400

            if User.query.filter_by(email=email).first():
                return render_template(
                    'register.html',
                    error='Email уже занят'
                ), 400

            user = User(
                username=username,
                email=email,
                role=role,
                is_deaf=is_deaf,
                accessibility_needs=needs
            )
            user.set_password(password)
            db.session.add(user)
            db.session.commit()
            return redirect(url_for('login_page'))

        return render_template('register.html')

    @app.route('/profile/<int:user_id>')
    def profile_page(user_id):
        user = db.session.get(User, user_id)
        if user is None:
            return 'Пользователь не найден', 404
        registrations = Registration.query.filter_by(user_id=user.id).all()
        return render_template(
            'profile.html',
            user=user,
            registrations=registrations
        )
    @app.route('/events/create', methods=['GET', 'POST'])
    @token_required
    def create_event_page(current_user_id, current_user_role):
        if current_user_role not in ('organizer', 'admin'):
            return render_template('create_event.html',
                                   error='Только организатор может создавать мероприятия'), 403

        if request.method == 'POST':
            title = (request.form.get('title') or '').strip()
            description = (request.form.get('description') or '').strip()
            event_date_str = request.form.get('event_date') or ''
            location = (request.form.get('location') or '').strip()

            if not title or not description or not event_date_str or not location:
                return render_template('create_event.html',
                                       error='Заполните все поля'), 400

            try:
                from datetime import datetime
                event_date = datetime.strptime(event_date_str, '%Y-%m-%dT%H:%M')
            except ValueError:
                return render_template('create_event.html',
                                       error='Неверный формат даты'), 400

            event = Event(
                title=title,
                description=description,
                event_date=event_date,
                location=location,
                is_inclusive=request.form.get('is_inclusive') == 'true',
                sign_language=request.form.get('sign_language') == 'true',
                visual_alerts=request.form.get('visual_alerts') == 'true',
                organizer_id=current_user_id
            )
            db.session.add(event)
            db.session.commit()
            return redirect(url_for('events_page'))

        return render_template('create_event.html')

    with app.app_context():
        db.create_all()

    return app


app = create_app()

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5001, debug=True)



